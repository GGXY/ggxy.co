[Unit]
Description=URL Redirector Service

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/redirector
ExecStart=/home/exedev/redirector/redirector
Restart=always
RestartSec=5
Environment=HOME=/home/exedev
Environment=USER=exedev
Environment=BASIC_AUTH_USER=admin
Environment=BASIC_AUTH_PASS=changeme
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
